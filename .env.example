# Second Story environment variables.
# Production values live in Vercel. For local overrides copy what you need into .env.local, which is gitignored.
# Local dev and tests already work without this file: .env.development and .env.test hold dev-only values.

# --- Login (single owner) ---
# The owner's email address. It is also the key of the owner's row in app_user.
OWNER_EMAIL=
# scrypt hash of the owner's password. Make one with `pnpm hash-password`. It contains no "$", so it is safe in .env files.
OWNER_PASSWORD_HASH=
# Signs the session cookie. At least 32 random characters, for example from `openssl rand -base64 48`.
SESSION_SECRET=

# --- Database ---
# Postgres connection string. A *.neon.tech host uses Neon's serverless driver, any other host uses `pg`.
# Leave it unset for local dev and tests, which use an in-process PGlite database instead.
DATABASE_URL=
# Where the local PGlite database lives when DATABASE_URL is unset. Default: .pglite/dev. "memory://" keeps it in memory.
PGLITE_DATA_DIR=

# --- Cloudinary (item photos, signed direct uploads) ---
# The cloud name from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
# The API key that goes with the secret below.
CLOUDINARY_API_KEY=
# The API secret. Server only. It signs uploads and must never reach the browser.
CLOUDINARY_API_SECRET=

# --- Price lookup ---
# RapidAPI key for the "eBay Average Selling Price" API. Server only.
RAPIDAPI_KEY=

# --- Display ---
# IANA time zone used for "today" and for showing timestamps, for example America/Chicago. Default: UTC.
NEXT_PUBLIC_APP_TIME_ZONE=

# --- Optional switches ---
# Set to 1 to mark the session cookie Secure on a host other than Vercel. On Vercel it is always Secure.
SESSION_COOKIE_SECURE=
# Set to 1 to show /dev/ui and /dev/table, which render the shared UI primitives. Leave unset in production.
ENABLE_DEV_ROUTES=

# --- Test and tooling only (set on the command line, not in a file) ---
# E2E_PORT            Port for the Playwright server. Default 3100. Use a different one per agent.
# E2E_DEV=1           Playwright serves with `next dev` instead of a production build.
# E2E_REAL_SERVICES=1 Lets the Playwright server see the real Cloudinary and RapidAPI keys from .env.local.
# PORT                Port for `pnpm dev:isolated`.
